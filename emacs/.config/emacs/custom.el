;;; -*- lexical-binding: t -*-
(custom-set-variables
 ;; custom-set-variables was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 '(auto-save-default nil)
 '(auto-save-file-name-transforms '((".*" "~/.emacs-saves/" t)))
 '(auto-save-list-file-prefix "~/.emacs-auto-save-list/.saves-")
 '(backup-by-copying t)
 '(backup-directory-alist '((".*" . "~/.emacs-saves")))
 '(custom-enabled-themes '(wombat))
 '(delete-old-versions t)
 '(indent-tabs-mode t)
 '(inhibit-startup-screen t)
 '(kept-new-versions 6)
 '(kept-old-version 2)
 '(package-selected-packages
   '(cmake-mode consult consult-eglot go-mode
				ido-completing-read+ magit multiple-cursors
				smex vertico yasnippet))
 '(tab-width 4)
 '(version-control t)
 '(visible-bell t))
(custom-set-faces
 ;; custom-set-faces was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 )
